<Application
    x:Class="ScriptRunner.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ScriptRunner"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    StartupUri="MainWindow.xaml">

    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="WindowForegroundColor">#FFFDFDFD</Color>
            <Color x:Key="WindowBackgroundColor">#FF1E1E1E</Color>
            <Color x:Key="AccentColor">#FF007ACC</Color>
            <Color x:Key="TabSelectedColor">#FFCCE5FF</Color>
            <Color x:Key="TabHoverColor">#FFDCEFFF</Color>
            <Color x:Key="TabBorderBrushColor">#FF00FFFF</Color>
            <Color x:Key="ControlBackgroundColor">#FF2D2D2D</Color>
            <Color x:Key="ButtonBackgroundColor">#FF2D2D2D</Color>
            <Color x:Key="CardBackgroundColor">#FF444444</Color>

            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{DynamicResource WindowBackgroundColor}" />
            <SolidColorBrush x:Key="ForegroundBrush" Color="{DynamicResource WindowForegroundColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
            <SolidColorBrush x:Key="TabSelectedBrush" Color="{DynamicResource TabSelectedColor}" />
            <SolidColorBrush x:Key="TabHoverBrush" Color="{DynamicResource TabHoverColor}" />
            <SolidColorBrush x:Key="TabBorderBrush" Color="{DynamicResource TabBorderBrushColor}" />
            <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{DynamicResource ControlBackgroundColor}" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="{DynamicResource CardBackgroundColor}" />
            <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{DynamicResource ButtonBackgroundColor}" />
            <SolidColorBrush x:Key="TabBackgroundBrush" Color="{DynamicResource WindowBackgroundColor}" />
            <ResourceDictionary.MergedDictionaries>
                <!--  Load either LightTheme.xaml OR DarkTheme.xaml dynamically  -->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>