<Window
    x:Class="ScriptRunner.LogShow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ScriptRunner"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Logs"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">

        <DataGrid
            x:Name="dataGrid"
            Margin="0,31,0,0"
            BorderBrush="#FF0BFFD8">
            <DataGrid.CellStyle>
                <Style />
            </DataGrid.CellStyle>
        </DataGrid>
        <RichTextBox
            x:Name="ViewerPopout"
            Background="#FF1D1D1D"
            Foreground="{DynamicResource ForegroundBrush}" BorderBrush="{DynamicResource AccentBrush}">
            <FlowDocument />
        </RichTextBox>
    </Grid>
</Window>
