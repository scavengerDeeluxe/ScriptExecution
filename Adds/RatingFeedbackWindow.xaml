<Window x:Class="ScriptRunner.RatingFeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScriptRunner"
        mc:Ignorable="d"
        Title="Submit Feedback" Height="400" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <Label Content="Email Address:"/>
            <TextBox x:Name="EmailTextBox" Margin="0,0,0,10"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <Label Content="Reason for Rating:"/>
            <ComboBox x:Name="ReasonComboBox" Margin="0,0,0,10">
                <ComboBoxItem Content="Works Great"/>
                <ComboBoxItem Content="Helpful Script"/>
                <ComboBoxItem Content="Outdated / Needs Update"/>
                <ComboBoxItem Content="Has Bugs"/>
                <ComboBoxItem Content="Does Not Work"/>
                <ComboBoxItem Content="Other"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <Label Content="Additional Details:"/>
            <TextBox x:Name="DetailsTextBox" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="100"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="SubmitButton" Content="Submit" Width="80" Margin="0,0,10,0" Click="SubmitButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
