

# Enhanced Windows Update Management Script with GUI Input
# Author: Enhanced Version
# Date: $(Get-Date -Format "yyyy-MM-dd")

Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing

# Enhanced logging function with colored console output
function Write-EnhancedLog {
    param(
        [string]$Message,
        [string]$Level = "INFO",
        [string]$LogFile = $global:LogFile
    )
    
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $logEntry = "[$timestamp] [$Level] $Message"
    
    # Console output with colors and icons
    switch ($Level) {
        "INFO"    { Write-Host "ℹ️  $Message" -ForegroundColor Cyan }
        "SUCCESS" { Write-Host "✅ $Message" -ForegroundColor Green }
        "WARNING" { Write-Host "⚠️  $Message" -ForegroundColor Yellow }
        "ERROR"   { Write-Host "❌ $Message" -ForegroundColor Red }
        "REBOOT"  { Write-Host "🔄 $Message" -ForegroundColor Magenta }
        "INSTALL" { Write-Host "📦 $Message" -ForegroundColor Blue }
        default   { Write-Host "📝 $Message" -ForegroundColor White }
    }
    
    # Write to log file
    $logEntry | Out-File -FilePath $LogFile -Append -Encoding UTF8
}

# Function to create GUI for server input
function Get-ServerListFromGUI {
    $form = New-Object System.Windows.Forms.Form
    $form.Text = "Windows Update Management - Server Selection"
    $form.Size = New-Object System.Drawing.Size(600, 500)
    $form.StartPosition = "CenterScreen"
    $form.FormBorderStyle = "FixedDialog"
    $form.MaximizeBox = $false
    $form.MinimizeBox = $false
    
    # Title label
    $titleLabel = New-Object System.Windows.Forms.Label
    $titleLabel.Location = New-Object System.Drawing.Point(10, 10)
    $titleLabel.Size = New-Object System.Drawing.Size(580, 30)
    $titleLabel.Text = "Enter server names (one per line) to manage Windows Updates:"
    $titleLabel.Font = New-Object System.Drawing.Font("Microsoft Sans Serif", 10, [System.Drawing.FontStyle]::Bold)
    $form.Controls.Add($titleLabel)
    
    # Text box for server list
    $textBox = New-Object System.Windows.Forms.TextBox
    $textBox.Location = New-Object System.Drawing.Point(10, 50)
    $textBox.Size = New-Object System.Drawing.Size(570, 300)
    $textBox.Multiline = $true
    $textBox.ScrollBars = "Vertical"
    $textBox.Font = New-Object System.Drawing.Font("Consolas", 10)
    $textBox.Text = "# Enter server names here, one per line`n# Example:`n# SERVER001`n# SERVER002`n# SERVER003"
    $form.Controls.Add($textBox)
    
    # Instruction label
    $instructionLabel = New-Object System.Windows.Forms.Label
    $instructionLabel.Location = New-Object System.Drawing.Point(10, 360)
    $instructionLabel.Size = New-Object System.Drawing.Size(570, 40)
    $instructionLabel.Text = "Note: Lines starting with # will be ignored as comments"
    $instructionLabel.ForegroundColor = [System.Drawing.Color]::Gray
    $form.Controls.Add($instructionLabel)
    
    # OK button
    $okButton = New-Object System.Windows.Forms.Button
    $okButton.Location = New-Object System.Drawing.Point(400, 410)
    $okButton.Size = New-Object System.Drawing.Size(80, 30)
    $okButton.Text = "OK"
    $okButton.DialogResult = [System.Windows.Forms.DialogResult]::OK
    $form.AcceptButton = $okButton
    $form.Controls.Add($okButton)
    
    # Cancel button
    $cancelButton = New-Object System.Windows.Forms.Button
    $cancelButton.Location = New-Object System.Drawing.Point(490, 410)
    $cancelButton.Size = New-Object System.Drawing.Size(80, 30)
    $cancelButton.Text = "Cancel"
    $cancelButton.DialogResult = [System.Windows.Forms.DialogResult]::Cancel
    $form.CancelButton = $cancelButton
    $form.Controls.Add($cancelButton)
    
    $result = $form.ShowDialog()
    
    if ($result -eq [System.Windows.Forms.DialogResult]::OK) {
        $serverList = $textBox.Text -split "`n" | ForEach-Object { 
            $_.Trim() 
        } | Where-Object { 
            $_ -ne "" -and -not $_.StartsWith("#") 
        }
        return $serverList
    } else {
        return $null
    }
    
    $form.Dispose()
}

# Initialize logging
$global:LogFile = "Windows_Update_Management_$(Get-Date -Format 'yyyyMMdd_HHmmss').log"
Write-EnhancedLog "=== Windows Update Management Script Started ===" "INFO"

# Get server list from GUI
Write-EnhancedLog "Opening server selection dialog..." "INFO"
$ServerList = Get-ServerListFromGUI

if ($null -eq $ServerList -or $ServerList.Count -eq 0) {
    Write-EnhancedLog "No servers selected. Exiting script." "WARNING"
    exit
}

Write-EnhancedLog "Selected $($ServerList.Count) servers for update management" "SUCCESS"

# Create server array
$ServerArray = @()
foreach ($serverName in $ServerList) {
    $ServerObj = New-Object -TypeName PSObject
    Add-Member -InputObject $ServerObj -MemberType NoteProperty -Name 'ServerName' -Value $serverName
    Add-Member -InputObject $ServerObj -MemberType NoteProperty -Name 'Status' -Value "Pending"
    Add-Member -InputObject $ServerObj -MemberType NoteProperty -Name 'LastChecked' -Value $null
    Add-Member -InputObject $ServerObj -MemberType NoteProperty -Name 'UpdatesInstalled' -Value 0
    $ServerArray += $ServerObj
    Write-EnhancedLog "Added server: $serverName" "INFO"
}




# Display initial status
Write-Host "`n🎯 Starting Windows Update Management for the following servers:" -ForegroundColor Green
foreach ($server in $ServerArray) {
    Write-Host "   📋 $($server.ServerName) - Status: $($server.Status)" -ForegroundColor Cyan
}
Write-Host ""

# Main processing loop
$EndJob = $true
$loopCount = 0

Do {
    $loopCount++
    Write-EnhancedLog "=== Processing Loop #$loopCount ===" "INFO"
    
    # Set $EndJob to $true, if all computer status is "Completed", the looping will end
    $EndJob = $true
    $completedServers = 0
    $pendingServers = 0
    
    foreach ($ServerObj in $ServerArray) {
        $system = $ServerObj.ServerName
        $ServerObj.LastChecked = Get-Date
        
        if ($ServerObj.Status -ne "Completed") {
            $approvedUpdates = 0
            $pendingpatches = 0
            $rebootpending = 0
            
            Write-EnhancedLog "Checking updates for server: $system" "INFO"
            
            try {
                # Test connectivity first
                if (-not (Test-Connection -ComputerName $system -Count 1 -Quiet)) {
                    Write-EnhancedLog "Server $system is not reachable" "ERROR"
                    continue
                }
                
                # Get list of all instances of CCM_SoftwareUpdate from root\CCM\ClientSDK for missing updates
                $TargetedUpdates = Get-WmiObject -ComputerName $ServerObj.ServerName -Namespace root\CCM\ClientSDK -Class CCM_SoftwareUpdate -Filter ComplianceState=0 -ErrorAction Stop
                $approvedUpdates = ($TargetedUpdates | Measure-Object).count
                $nonestateupdates = ($TargetedUpdates | Where-Object {$_.EvaluationState -eq 0} | Measure-Object).count
                $pendingpatches = ($TargetedUpdates | Where-Object {$_.EvaluationState -ne 8} | Measure-Object).count
                $rebootpending = ($TargetedUpdates | Where-Object {$_.EvaluationState -eq 8} | Measure-Object).count
                $failedUpdates = ($TargetedUpdates | Where-Object {$_.EvaluationState -eq 13} | Measure-Object).count
                
                Write-EnhancedLog "Server $system - Approved: $approvedUpdates, Pending: $pendingpatches, Reboot Required: $rebootpending, Failed: $failedUpdates" "INFO"
                
            } catch {
                Write-EnhancedLog "Failed to query WMI on $system : $($_.Exception.Message)" "ERROR"
                continue
            }
            
            # Handle failed updates first
            if ($failedUpdates -gt 0) {
                $EndJob = $false
                Write-EnhancedLog "Attempting to reinstall $failedUpdates failed updates on $system" "INSTALL"
                
                try {
                    $MissingUpdatesReformatted = @($TargetedUpdates | ForEach-Object {if($_.EvaluationState -eq 13){[WMI]$_.__PATH}})
                    $InstallReturn = Invoke-WmiMethod -ComputerName $system -Class CCM_SoftwareUpdatesManager -Name InstallUpdates -ArgumentList (,$MissingUpdatesReformatted) -Namespace root\ccm\clientsdk
                    
                    $failedUpdateNames = $MissingUpdatesReformatted | ForEach-Object { $_.Name }
                    Write-EnhancedLog "Initiated reinstallation of failed updates on $system" "SUCCESS"
                    $failedUpdateNames | ForEach-Object { Write-EnhancedLog "  - $_" "INFO" }
                    
                } catch {
                    Write-EnhancedLog "Failed to reinstall updates on $system : $($_.Exception.Message)" "ERROR"
                }
            }
            
            # Handle pending updates
            if (($approvedUpdates -gt 0) -and ($nonestateupdates -gt 0)) {
                $EndJob = $false
                Write-EnhancedLog "Installing $nonestateupdates pending updates on $system" "INSTALL"
                
                try {
                    $MissingUpdatesReformatted = @($TargetedUpdates | ForEach-Object {if($_.ComplianceState -eq 0){[WMI]$_.__PATH}})
                    $InstallReturn = Invoke-WmiMethod -ComputerName $system -Class CCM_SoftwareUpdatesManager -Name InstallUpdates -ArgumentList (,$MissingUpdatesReformatted) -Namespace root\ccm\clientsdk
                    Write-EnhancedLog "Successfully initiated installation of $nonestateupdates updates on $system" "SUCCESS"
                    $ServerObj.UpdatesInstalled += $nonestateupdates
                    
                } catch {
                    Write-EnhancedLog "Failed to install updates on $system : $($_.Exception.Message)" "ERROR"
                }
            }
            # Handle reboot scenario
            elseif (($pendingpatches -eq 0) -and ($rebootpending -gt 0) -and ($approvedUpdates -eq $rebootpending)) {
                $EndJob = $false
                Write-EnhancedLog "All updates installed on $system - Initiating reboot" "REBOOT"
                
                try {
                    Restart-Computer $ServerObj.ServerName -Force -ErrorAction Stop
                    $ServerObj.Status = "Completed"
                    Write-EnhancedLog "Successfully initiated reboot for $system" "SUCCESS"
                } catch {
                    Write-EnhancedLog "Failed to reboot $system : $($_.Exception.Message)" "ERROR"
                }
            }
            # Check if server is fully updated
            elseif (($pendingpatches -eq 0) -and ($rebootpending -eq 0)) {
                $ServerObj.Status = "Completed"
                Write-EnhancedLog "Server $system is fully updated and patched" "SUCCESS"
            }
            # Still waiting for updates to complete
            else {
                Write-EnhancedLog "Server $system - Waiting for updates to complete (Approved: $approvedUpdates, Pending: $pendingpatches, Reboot: $rebootpending)" "INFO"
                $EndJob = $false
            }
        }
        
        # Count status for summary
        if ($ServerObj.Status -eq "Completed") {
            $completedServers++
        } else {
            $pendingServers++
        }
    }
    
    # Display current status summary
    Write-Host "`n📊 Current Status Summary:" -ForegroundColor Yellow
    Write-Host "   ✅ Completed: $completedServers servers" -ForegroundColor Green
    Write-Host "   ⏳ Pending: $pendingServers servers" -ForegroundColor Yellow
    
    if (-not $EndJob) {
        Write-EnhancedLog "Waiting 30 seconds before next check..." "INFO"
        Start-Sleep -Seconds 30
    }
    
} until ($EndJob -eq $true)

# Final summary
Write-Host "`n🎉 Windows Update Management Completed!" -ForegroundColor Green
Write-EnhancedLog "=== Final Summary ===" "SUCCESS"
foreach ($server in $ServerArray) {
    $status = if ($server.Status -eq "Completed") { "✅" } else { "❌" }
    Write-EnhancedLog "$status $($server.ServerName) - Status: $($server.Status), Updates Installed: $($server.UpdatesInstalled), Last Checked: $($server.LastChecked)" "INFO"
}
Write-EnhancedLog "=== Windows Update Management Script Completed ===" "SUCCESS"
