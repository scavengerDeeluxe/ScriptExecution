<?xml version="1.0" encoding="utf-8"?>
<SyntaxDefinition name="PowerShell Dracula" extensions=".ps1;.psm1" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <!-- Dracula Theme Colors (minimal example) -->
	<Color name="Comment" foreground="#6272A4" exampleText="// comment" />
	<Color name="String" foreground="#F1FA8C" exampleText="string text = &quot;Hello, World!&quot;" />
	<Color name="Char" foreground="#FF79C6" exampleText="char linefeed = '\n';" />
	<Color name="Punctuation" foreground="#F8F8F2" exampleText="a(b.c);" />
	<Color name="NumberLiteral" foreground="#BD93F9" exampleText="3.1415f" />
	<Color name="Keywords" fontWeight="bold" foreground="#FF79C6" exampleText="if (a)" />
	<Color name="Variable" foreground="#8BE9FD" exampleText="$param = 1" />
	<Color name="AtOperator" fontWeight="bold" foreground="#FF5555" />
	<Color name="AtToken" foreground="#8BE9FD" exampleText="$param = 1" />
	<Color name="ExceptionKeywords" fontWeight="bold" foreground="#FF5555" />
	<Color name="GotoKeywords" foreground="#FF79C6" />
	<Color name="Url" foreground="#61AFEF" fontWeight="bold" exampleText="https://example.com/path?x=1" />
	<Color name="RosyBrown" foreground="{DynamicResource ForegroundBrush}" />

	<Color name="ReferenceTypes" foreground="#8BE9FD" />
	<Color name="Command" fontWeight="bold" foreground="#50FA7B" />
	<Color name="Operators" foreground="#FFB86C" exampleText="-eq" />
	<Color name="Hyperlink" foreground="#6272A4" fontWeight="bold" background="#6272A4" />
	<RuleSet ignoreCase="true">
		<Span>
			<Begin>\#</Begin>
			<End>\n</End>
			<RuleSet>
				<Rule color="Hyperlink">https?://[^\s"']+</Rule>
				<Rule color="Comment">[^\n]+</Rule>
			</RuleSet>
		</Span>

		<Span color="String">
			<Begin>"</Begin>
			<End>"</End>
			<RuleSet>
				<!-- span for escape sequences -->
				<Span begin="\\" end="."/>
			</RuleSet>
		</Span>

		<Span color="Char">
			<Begin>'</Begin>
			<End>'</End>
			<RuleSet>
				<!-- span for escape sequences -->
				<Span begin="\\" end="."/>
			</RuleSet>
		</Span>
<Span color="String" begin="@" end="m" />
<Span color="String" begin="http" end="/" />
<Span color="String" begin="http" end="m" />
<Span color="String" begin="http" end="g" />

<Span color="String" begin="@'" end="'@" />
		<Span color="String" multiline="true">
			<Begin color="String">@"</Begin>
			<End>"@</End>
			<RuleSet>
				<!-- span for escape sequences -->
				<Span begin='""' end=""/>
			</RuleSet>
		</Span>
  <!-- 1) Define a color for URLs -->

  <!-- 2) Add a ruleset (you can also add this Rule to an existing RuleSet for your language) -->


    <!-- JS: /https?:\/\/(?:www\.)?[-a-zA-Z0-9@:%._\+~#=]{1,256}\.[a-zA-Z0-9()]{1,6}\b(?:[-a-zA-Z0-9()@:%_\+.~#?&//=]*)/g -->
    <!-- XSHD (.NET regex, XML-escaped '&'): -->

    <!-- ... your other rules ... -->
		<Keywords color="Keywords">
			<Word>while</Word>
			<Word>param</Word>
			<Word>end</Word>
			<Word>define</Word>
			<Word>else</Word>
			<Word>from</Word>
			<Word>foreach</Word>
			<Word>var</Word>
			<Word>dynamicparam</Word>
			<Word>filter</Word>
			<Word>dp</Word>
			<Word>until</Word>
			<Word>for</Word>
			<Word>exit</Word>
			<Word>switch</Word>
			<Word>process</Word>
			<Word>begin</Word>
			<Word>elseif</Word>
			<Word>if</Word>
			<Word>in</Word>
			<Word>data</Word>
			<Word>class</Word>
			<Word>using</Word>
			<Word>function</Word>
		</Keywords>

		<Keywords color="ExceptionKeywords">
			<Word>catch</Word>
			<Word>finally</Word>
			<Word>throw</Word>
			<Word>trap</Word>
			<Word>try</Word>
		</Keywords>

		<Keywords color="GotoKeywords">
			<Word>break</Word>
			<Word>continue</Word>
			<Word>return</Word>
		</Keywords>

		<Keywords color="ReferenceTypes">
			<Word>class</Word>
		</Keywords>

		<Keywords color="Operators">
			<Word>-not</Word>
			<Word>-band</Word>
			<Word>-bor</Word>
			<Word>-replace</Word>
			<Word>-ireplace</Word>
			<Word>-creplace</Word>
			<Word>-and</Word>
			<Word>-or</Word>
			<Word>-is</Word>
			<Word>-isnot</Word>
			<Word>-as</Word>
			<Word>-lt</Word>
			<Word>-le</Word>
			<Word>-gt</Word>
			<Word>-ge</Word>
			<Word>-eq</Word>
			<Word>-ne</Word>
			<Word>-contains</Word>
			<Word>-notcontains</Word>
			<Word>-like</Word>
			<Word>-notlike</Word>
			<Word>-match</Word>
			<Word>-notmatch</Word>
		</Keywords>

		<Rule color="Variable">
			\$[\d\w_]+
		</Rule>

		<Rule color="Command">
			[\w]+-[\w]+
		</Rule>

		<!-- Digits -->
		<Rule color="NumberLiteral">
			\b0[xX][0-9a-fA-F]+  # hex number
			|
			(	\b\d+(\.[0-9]+)?   #number with optional floating point
			|	\.[0-9]+           #or just starting with floating point
			)
			([eE][+-]?[0-9]+)? # optional exponent
		</Rule>
		<Rule foreground="Cyan">\b0[xX][0-9a-fA-F]+|(\b\d+(\.[0-9]+)?|\.[0-9]+)([eE][+-]?[0-9]+)?</Rule>
		<Rule color="Comment">[^\n]+</Rule>
<Rule color="Hyperlink">/(?:https?:\/\/)(?:[\w]+\.)([a-zA-Z\.]{2,63})([\/\w\.-]*)*\/?/g</Rule>
<Rule color="Hyperlink">\bhttp\w*\b+</Rule>
<Rule color="Hyperlink">(http:\/\/www\.|http:\/\/www\.|https:\/\/|http:\/\/)?[a-zA-Z0-9]{2,}(\.[a-zA-Z0-9]{2,})(\.[a-zA-Z0-9]{2,})?\/[a-zA-Z0-9]{2,}</Rule>
<Rule color="Hyperlink">((ht|f)tp(s)?:\/\/)?(w{0,3}\.)?[a-zA-Z0-9_\-\.\:\#\/\~\}]+(\.[a-zA-Z]{1,4})(\/[a-zA-Z0-9_\-\.\:\#\/\~\}]*)?</Rule>

<Rule color="AtOperator">@[\(\{]</Rule>
<Rule color="AtToken">@\S+</Rule>
<Rule color="Punctuation">...</Rule>
	</RuleSet>
</SyntaxDefinition>